# Kopieer naar .env (wordt niet gecommit). Zonder deze waarden draait de app volledig als gast (localStorage).
# Lovable Cloud vult deze automatisch in zodra de backend is ingeschakeld.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Optioneel, privacyvriendelijke analytics (Plausible of Umami). Leeg = geen analytics.
VITE_ANALYTICS_DOMAIN=
VITE_ANALYTICS_SCRIPT=
